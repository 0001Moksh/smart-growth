{
    "version": 2,
    "builds": [
      { "src": "app.py", "use": "@vercel/python" }
    ],
    "routes": [
      { 
        "src": "/(.*)", 
        "dest": "app.py",
        "methods": ["GET"],
        "headers": { 
          "Access-Control-Allow-Origin": "*",
          "Access-Control-Allow-Methods": "GET",
          "Access-Control-Allow-Headers": "*"
        }
      }
    ]
  }
  